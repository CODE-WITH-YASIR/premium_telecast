# ==============================================================================
# PREMIUM LIVE TV - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Server-Side Administrator Email Allowlist ---
# Default administrator account email for local/hosted management
ADMIN_EMAIL=mohamedyasir2000@gmail.com

# --- Server-only IPTV Playlist Configuration ---
# Comma-separated "id:label:url" triplets for M3U/M3U8 playlist sources.
# Leave unset to use default (iptv-org public global index playlist).
# IPTV_PLAYLIST_SOURCES=in:India:https://iptv-org.github.io/iptv/countries/in.m3u,us:United States:https://iptv-org.github.io/iptv/countries/us.m3u
IPTV_PLAYLIST_SOURCES=

# --- Optional Client-Exposed Variables ---
NEXT_PUBLIC_SITE_URL=https://premium-telecast.vercel.app
NEXT_PUBLIC_EPG_URL=
DEV_LAN_ORIGIN=

# --- Tamil Live TV Health Engine Configuration ---
TAMIL_IPTV_SOURCE_URL=https://iptv-org.github.io/iptv/languages/tam.m3u
TAMIL_PLAYLIST_SYNC_INTERVAL_HOURS=3
HEALTH_CHECK_CONCURRENCY=5
TAMIL_CONNECT_TIMEOUT_MS=5000
TAMIL_READ_TIMEOUT_MS=10000
